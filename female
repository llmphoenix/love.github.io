Add-Type -AssemblyName System.Speech
$s = New-Object System.Speech.Synthesis.SpeechSynthesizer
$s.Rate = -2
foreach ($v in $s.GetInstalledVoices()) { if ($v.VoiceInfo.Culture -like "zh-CN*") { $s.SelectVoice($v.VoiceInfo.Name); break } }
$s.SetOutputToWaveFile("female")
$text = @"
你是我的玫瑰，也是我的春天。这一生，只想好好疼你、爱你。
"@
$s.Speak($text)
$s.SetOutputToDefaultAudioDevice()
